{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "module": "CommonJS",
    "moduleResolution": "node",
    "paths": {
      "@messenger/shared": [
        "../../packages/shared/src"
      ],
      "@messenger/shared/*": [
        "../../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/shared/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}